# Azure Service Principal-credentials for "postlister"-containeren.
# Delt for alle kommuner under bronze/postlister/ (Lillestrøm, Bærum, osv.)
# - ikke kommune-spesifikk.
#
# Brukes kun av _azure_credential() i scraper_lib.py når koden kjører
# UTENFOR Databricks (f.eks. lokal testing eller manuell kjøring av
# 2020-today_dump-scriptene). I Databricks hentes credentials i stedet fra
# secrets-scope "postlister" - denne fila trengs ikke der.
#
# Kopier denne fila til ".env" i samme mappe og fyll inn ekte verdier fra
# Azure Entra ID-appregistreringen. ".env" er gitignored og skal ALDRI
# committes.

SP-PIPELINE-POSTLISTER-CLIENT-ID=00000000-0000-0000-0000-000000000000
SP-PIPELINE-POSTLISTER-TENANT-ID=00000000-0000-0000-0000-000000000000
SP-PIPELINE-POSTLISTER-CLIENT-SECRET=din-client-secret-her
